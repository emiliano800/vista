{
  "name": "vista-recorder",
  "version": "0.5.2",
  "description": "One-button desktop recorder for Vista task mining: always-on overlay, cross-platform input hooks, active-window + screenshot capture, on-device redaction.",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "start:demo": "electron . --demo",
    "test": "node --test test/*.test.js",
    "test:ui": "electron test/dashboard-smoke.mjs",
    "test:browser": "electron test/cu-browser-smoke.mjs",
    "dist": "electron-builder"
  },
  "dependencies": {
    "get-windows": "^9.3.0",
    "uiohook-napi": "^1.5.5"
  },
  "optionalDependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6"
  },
  "devDependencies": {
    "electron": "~43.7.2",
    "electron-builder": "^26.0.12"
  },
  "overrides": {
    "tar": "^7.5.21"
  },
  "build": {
    "appId": "org.bumpsolutions.vista.recorder",
    "productName": "Vista Recorder",
    "files": ["src/**/*", "ui/**/*", "package.json"],
    "extraResources": [
      { "from": "../web/public/tokens.css", "to": "web/public/tokens.css" },
      { "from": "../web/public/fonts", "to": "web/public/fonts" }
    ],
    "asarUnpack": ["**/node_modules/uiohook-napi/**", "**/node_modules/get-windows/**"],
    "mac": {
      "identity": "-",
      "hardenedRuntime": false,
      "category": "public.app-category.productivity",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "artifactName": "Vista-Recorder-mac-${arch}.${ext}"
    },
    "win": {
      "target": ["nsis"],
      "artifactName": "Vista-Recorder-windows-setup.${ext}"
    }
  }
}
