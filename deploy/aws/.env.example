# Copy to deploy/aws/.env (gitignored). Sourced by deploy/aws/deploy.sh and manage.sh.
AWS_REGION=us-east-1
# AWS_PROFILE=default
STACK_NAME=vista

# Leave unset to use the default VPC and all of its public subnets.
# VPC_ID=vpc-0123456789abcdef0
# SUBNET_IDS=subnet-aaaa,subnet-bbbb

# Optional: agent runs and the recording AI review call OpenAI when set; stored in Secrets
# Manager by the stack and injected only into the backend tasks.
# OPENAI_API_KEY=sk-...
# Optional: TypeSafe Jev key for recorder workflow candidates and the Computer Use Agent; without it
# Jev is stub and the Computer Use Agent executes nothing. Either a TypeSafe key against the
# default base URL, or an OpenRouter key with the two lines below (OpenRouter serves the same
# /systemone API; usage.cost is billed to the OpenRouter account).
# TYPESAFE_API_KEY=apikey_...
# TYPESAFE_BASE_URL=https://openrouter.ai/api/v1
# TYPESAFE_MODEL=~typesafe/jev-latest
# Optional: chat model id (default gpt-4o-mini; production uses gpt-6-astra).
# OPENAI_MODEL=gpt-6-astra
# Optional operator key enabling POST /tenants (prefer manage.sh create-workspace instead).
# PROVISIONING_KEY=

# 0 = report uploads only (default). 1 = also run the job worker; required for the recorder's
# AI review (otherwise every review stays "Explaining…") and for agent runs.
WORKER_DESIRED_COUNT=0
# Set to false only for throwaway stacks you intend to delete.
DB_DELETION_PROTECTION=true
# ALLOWED_ORIGINS=["https://bumpsolutions.org","https://vista.emilianocamachoalmanza.workers.dev"]
