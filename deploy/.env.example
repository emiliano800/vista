# Generate two different values with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-random-hex-password
S3_PASSWORD=replace-with-a-different-random-hex-password
# DNS A/AAAA record pointing to your backend server. Caddy provides HTTPS.
API_HOST=api.bumpsolutions.org
# Optional: lets the worker write AI explanations for recorded stretches. Leave empty and
# every stretch asks the employee to explain instead.
OPENAI_API_KEY=
