VISTA_DATABASE_URL=postgresql+psycopg://vista:vista@localhost:5432/vista
VISTA_S3_ENDPOINT_URL=http://localhost:9000
VISTA_S3_ACCESS_KEY=vista
VISTA_S3_SECRET_KEY=vista-secret
VISTA_S3_BUCKET=vista-reports
# Hosted alternatives (see deploy/aws/README.md): VISTA_DB_HOST/PORT/NAME/USER/PASSWORD/SSLMODE
# compose VISTA_DATABASE_URL; empty VISTA_S3_ENDPOINT_URL + keys use the AWS IAM role, with
# VISTA_S3_REGION set. VISTA_MIGRATE_ON_START=true migrates in the container entrypoint.
# Optional: agent runs and recording AI review call the model when set; leave unset for the stub
# (review items then fall to "employee must explain"). Both need `python -m vista.jobs.worker`.
# The desktop recorder reads the same file. Any OpenAI-compatible endpoint works; OpenRouter example:
# VISTA_OPENAI_API_KEY=sk-or-v1-...
# VISTA_OPENAI_BASE_URL=https://openrouter.ai/api/v1
# VISTA_OPENAI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# VISTA_OPENAI_PROVIDER_ONLY=nvidia
# Plain OpenAI: VISTA_OPENAI_API_KEY=sk-... and VISTA_OPENAI_MODEL=gpt-4.1-nano (fastest)
# TypeSafe Jev (typed judgments for recorder workflow candidates; agents/jev.py). Unset → stub answers,
# i.e. nothing is proposed. VISTA_RECORDER_INTERPRETER=chat falls back to the OpenAI-compatible model.
# VISTA_TYPESAFE_API_KEY=apikey_...
# VISTA_TYPESAFE_MODEL=jev-latest
# Computer Use Agent (computer_use/): pause when Jev's p_irreversible >= threshold; how long the
# recorder has to answer a step; recorder lease and offer lifetimes. Set VISTA_COMPUTER_USE_ENABLED=false
# to refuse every run start.
# VISTA_COMPUTER_USE_RISK_THRESHOLD=0.3
# VISTA_COMPUTER_USE_STEP_TIMEOUT_S=180
# VISTA_COMPUTER_USE_LEASE_S=300
# VISTA_COMPUTER_USE_OFFER_TTL_S=1800
# Recorder: VISTA_ADMIN=1 shows the workspace / privacy / AI panels in Settings.

# Keep true on HTTPS deployments. Set false only for local HTTP browser testing.
VISTA_COOKIE_SECURE=true
# Browser origins allowed through the Cloudflare proxy (JSON array).
VISTA_ALLOWED_ORIGINS=["https://bumpsolutions.org","https://vista.emilianocamachoalmanza.workers.dev"]
# Optional operator provisioning endpoint; disabled unless explicitly set.
# VISTA_PROVISIONING_KEY=generate-a-random-value
